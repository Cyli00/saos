        <mxCell id="zos_stop_edge" parent="1" edge="1" source="zos_gate" target="u6" value="用户决定停止" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;dashed=1;strokeWidth=1.5;fontSize=11;fontColor=#b85450;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;">
          <mxGeometry relative="1" as="geometry">
