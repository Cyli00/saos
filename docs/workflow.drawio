        <mxCell id="e35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#82b366;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" source="a15" target="t9" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=10;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" source="a15" target="a16" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e37" value="continue&lt;br&gt;按 next_tier 升级手段" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=2;fontSize=11;fontColor=#b46504;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.25;exitY=0.25;exitPerimeter=1;entryX=0;entryY=0.5;" parent="1" source="a16" target="a11" edge="1">
          <mxGeometry relative="1" as="geometry">
