          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="u6" value="用户依据证据&lt;br&gt;决定停止" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="85" y="2740.0" width="240" height="56" as="geometry" />
        </mxCell>
        <mxCell id="t10" value="&lt;b&gt;saos stop --reason &quot;…&quot; --quote &quot;…&quot;&lt;/b&gt;&lt;br&gt;→ stops.jsonl；ledger 状态 stopped，此版本拒绝后续轮次" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Consolas;" parent="1" vertex="1">
          <mxGeometry x="980" y="2740.0" width="400" height="56" as="geometry" />
        </mxCell>
        <mxCell id="a17" value="&lt;b&gt;生成当前阶段报告&lt;/b&gt;&lt;br&gt;需求涉及制造装配时，先做相应公差扫描" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="490" y="2835" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="t11" value="&lt;b&gt;saos scan&lt;/b&gt;（tolerance，按需）→ scans/NNN/&lt;br&gt;&lt;b&gt;saos report&lt;/b&gt; → report/index.html + latest.json&lt;br&gt;编号 HTML 与 JSON 副本封存；引用当前需求和判定&lt;br&gt;从合资格轮次选交付镜头；不可交付则 diagnostic&lt;br&gt;没有有效设计时明确说明；停止时保留理由与原话&lt;br&gt;Optiland 报告注明尚未经 OpticStudio 复测&lt;br&gt;记录需求确认至模型确认、报告认可耗时" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Consolas;" parent="1" vertex="1">
          <mxGeometry x="980" y="2820" width="400" height="150" as="geometry" />
        </mxCell>
        <mxCell id="a18" value="&lt;b&gt;报告属于哪个阶段？&lt;/b&gt;&lt;br&gt;探索阶段 → 交给用户判断&lt;br&gt;OpticStudio 阶段 → 最终交付" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="500" y="3000" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="u7" value="&lt;b&gt;阅读 Optiland 阶段报告&lt;/b&gt;&lt;br&gt;数值尚未经 OpticStudio 复测&lt;br&gt;有可交付轮次时再决定是否认可" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="85" y="3000" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e41" value="决定停止" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=10;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" source="u5" target="u6" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e42" value="原话 + 选项全文" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=10;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" source="u6" target="t10" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e43" value="achieved / limit / exhausted" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=10;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" source="a16" target="a17" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e44" value="报告显示停止理由" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#82b366;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" source="t10" target="t11" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#82b366;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" source="a17" target="t11" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=10;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" source="a17" target="a18" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e47" value="Optiland 探索报告" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=10;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" parent="1" source="a18" target="u7" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="&lt;b style=&quot;font-size:14px&quot;&gt;底线（不可违反）&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. 记录需求：用户原话与 agent 假设均可追溯&lt;br&gt;2. 每轮数值来自实际后端计算，并记录 backend&lt;br&gt;3. 最终交付以用户认可后的 OpticStudio 阶段为准&lt;br&gt;4. 改常量、范围、目标须重新确认，不偷偷放宽&lt;br&gt;5. 本设计要制造的零件用真实材料，模型玻璃只供探索&lt;br&gt;6. 面向用户的报告统一 HTML" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;arcSize=4;fillColor=#fdf2f2;strokeColor=#b85450;" parent="1" vertex="1">
          <mxGeometry x="1450" y="40" width="400" height="250" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="&lt;b style=&quot;font-size:14px&quot;&gt;手段层级与阶段内终止判断&lt;/b&gt;&lt;br&gt;&lt;br&gt;local：现有变量局部优化&lt;br&gt;variables：更多变量 / 调整评价函数&lt;br&gt;materials：Optiland 用 opt glass；ZOS 用替换玻璃搜索&lt;br&gt;global：Optiland 全局搜索；ZOS 全局搜索 / Hammer&lt;br&gt;structure：增减镜片、拆分、非球面化&lt;br&gt;&lt;br&gt;achieved：满足硬条件与目标，并按需求完成继续改进&lt;br&gt;limit：用完本阶段、当前需求版本的轮次预算&lt;br&gt;exhausted：明显进步后各允许手段已试过或有证据排除&lt;br&gt;stopped：用户决定，saos stop 记录理由和原话&lt;br&gt;continue：诊断并选择尚未尝试的手段&lt;br&gt;&lt;br&gt;verify 是 OpticStudio 阶段基线，不消耗优化轮次&lt;br&gt;rebase 不计预算；改判定不能绕过轮次上限&lt;br&gt;旧阶段的轮次、停止及层级排除不消耗新阶段预算&lt;br&gt;比较 shortfall，不混用两阶段数值，也不以 merit 代替" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;arcSize=4;fillColor=#fffaf0;strokeColor=#d79b00;" parent="1" vertex="1">
          <mxGeometry x="1450" y="310" width="400" height="390" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="&lt;b style=&quot;font-size:14px&quot;&gt;何时停下来问用户&lt;/b&gt;&lt;br&gt;&lt;br&gt;• 需求自相矛盾，或常量 / 范围 / 达标线依据不足&lt;br&gt;• 测量口径有多种读法且影响结果&lt;br&gt;• 可行性判断或一阶分析表明结构达不到目标，或某项 must 差通过线好几倍&lt;br&gt;• 已有结果不支持继续当前策略（brief.review）&lt;br&gt;• 结构要改成用户没见过的样子&lt;br&gt;&lt;br&gt;会改变需求的问题写成 open_questions（blocking: true），未答时 round / opt local / hammer / global 拒绝运行&lt;br&gt;停下来之前先 saos ui notify，窗口顶部写明要用户看什么" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;arcSize=4;fillColor=#fffdf0;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="1450" y="720" width="400" height="250" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="&lt;b style=&quot;font-size:14px&quot;&gt;计算后端与长任务&lt;/b&gt;&lt;br&gt;&lt;br&gt;• 认可前只用 Optiland 进程内计算；表达不了的功能报告为能力缺口&lt;br&gt;• 认可前不启动 OpticStudio，建模说明不做双端对齐&lt;br&gt;• 不在每一轮自动由 ZOS 复算；报告认可（zos begin）后才启动 OpticStudio&lt;br&gt;• saos scan / ctx.map 共用常驻 worker 池，空闲后关闭&lt;br&gt;• 探索阶段 Optiland worker 默认使用逻辑核数减 2&lt;br&gt;• OpticStudio 阶段 worker 默认 4；许可上限含用户窗口&lt;br&gt;• 用 saos.kit、ctx.measure、saos.search；不自写光学追迹&lt;br&gt;• 优化 / round / check / scan / exec / zos begin 记录进度&lt;br&gt;• saos job show 查看；saos job cancel 请求安全中断&lt;br&gt;• 长任务按需 --detach；客户端超时不代表后台失败&lt;br&gt;• 进入阶段后 load / build / 重启加载都保持 ZOS&lt;br&gt;• 取消和恢复不得覆盖封存镜头或重复追加已提交轮次" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;arcSize=4;fillColor=#f3faf1;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="1450" y="990" width="400" height="450" as="geometry" />
        </mxCell>
        <mxCell id="p5" value="&lt;b style=&quot;font-size:14px&quot;&gt;封存与恢复&lt;/b&gt;&lt;br&gt;&lt;br&gt;evaluations/、rounds/、models/、scans/、报告编号副本和 stages/ 写入 seals.jsonl&lt;br&gt;入口与对比都封存后，才开放后续设计&lt;br&gt;重试复用 verify 的同轮证据，不重算冒充原记录&lt;br&gt;历史坏确认按路径提示；完整匹配确认可用&lt;br&gt;saos job verify 显示改动；有改动时报告拒绝生成" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;arcSize=4;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="1450" y="1460" width="400" height="140" as="geometry" />
        </mxCell>
        <mxCell id="lg" value="&lt;b style=&quot;font-size:14px&quot;&gt;图例&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;arcSize=4;fillColor=#ffffff;strokeColor=#999999;" parent="1" vertex="1">
          <mxGeometry x="1450" y="1770" width="400" height="330" as="geometry" />
        </mxCell>
