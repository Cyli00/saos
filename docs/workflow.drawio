        <mxCell id="e20" value="改需求 → 重新确认" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;dashed=1;strokeWidth=1.5;fontSize=11;fontColor=#b85450;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0;exitY=0.5;entryX=0;entryY=0.3;" parent="1" source="u3" target="u2" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="78" y="1235.0" />
              <mxPoint x="78" y="680.0" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e21" value="形成起点依据" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=10;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" source="a8" target="a9" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#82b366;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" source="a9" target="t4" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e23" value="交出说明页面，处理或解释警告" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=10;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="a9" target="u4" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="650" y="1405.0" />
              <mxPoint x="205" y="1405.0" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e24" value="认可（原话）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=10;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.6;entryX=0;entryY=0.5;" parent="1" source="u4" target="t5" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a10" value="&lt;b&gt;saos round&lt;/b&gt;：记录探索阶段基线&lt;br&gt;OpticStudio 阶段由 zos begin 自动写 verify 基线" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="490" y="1560.0" width="320" height="52" as="geometry" />
        </mxCell>
        <mxCell id="a11" value="&lt;b&gt;诊断：可达性阶梯&lt;/b&gt;&lt;br&gt;守恒量 / 不变量（光展量、Lagrange、Petzval）&lt;br&gt;→ 轴上一点 → 全视场；低一级不成立 = 结构问题" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="490" y="1635.0" width="320" height="76" as="geometry" />
        </mxCell>
        <mxCell id="a12" value="&lt;b&gt;找最大加权差距的机理&lt;/b&gt;&lt;br&gt;选 1–6 个变量 + ≥1 个阴性对照&lt;br&gt;先写预测（机理、方向、量级）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="490" y="1740.0" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="t7" value="&lt;b&gt;saos scan --plan（probes 计划）&lt;/b&gt;&lt;br&gt;基准 + 各 ±delta 在 worker 池同时跑 · quick_focus / 脚本补偿&lt;br&gt;镜头不变 → scans/NNN/（ranking · review）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Consolas;" parent="1" vertex="1">
          <mxGeometry x="980" y="1740.0" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a13" value="&lt;b&gt;读 ranking / review&lt;/b&gt;&lt;br&gt;预测成立？&lt;br&gt;有变量能动目标？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="510" y="1835.0" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="u5" value="&lt;b&gt;停下来问用户&lt;/b&gt;&lt;br&gt;证据 · 影响 · 建议选项&lt;br&gt;用户选：改需求 / 停止 / 继续" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="85" y="1850.0" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a14" value="&lt;b&gt;按机理选择优化手段&lt;/b&gt;&lt;br&gt;Optiland：local / glass 默认 Torch 雅可比 + 信赖域；能力缺口回退 trf；global 全局搜索&lt;br&gt;OpticStudio：DLS、Hammer、全局搜索&lt;br&gt;到期恢复快照；复核未完成则补查后再记录轮次&lt;br&gt;&lt;br&gt;SciPy / Torch：交叠或任一视场/波长有效率 &amp;lt;95%&lt;br&gt;拒绝候选步；信赖域缩步或下降法回溯，只保留已验证快照&lt;br&gt;Torch：连续失效光线惩罚，保护路径不作为实测&lt;br&gt;分段报告收益；物理不成立的状态不得交付" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="490" y="2170.0" width="320" height="180" as="geometry" />
        </mxCell>
        <mxCell id="t8" value="&lt;b&gt;saos opt vary / merit / local / glass / hammer / global&lt;/b&gt;&lt;br&gt;saos lens analysis · saos exec（kit / ctx.measure）&lt;br&gt;saos scan / ctx.map：常驻 worker 池按任务阶段选后端&lt;br&gt;scan --detach：后台线程，主实例仍可用；--show 看进度&lt;br&gt;opt / exec / check / round --detach：runs/ 下保存结果&lt;br&gt;review：交叠检查、--measure 前后对比与 valid&lt;br&gt;progress.json：saos job show / saos job cancel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Consolas;" parent="1" vertex="1">
          <mxGeometry x="980" y="2170" width="400" height="180" as="geometry" />
        </mxCell>
        <mxCell id="a15" value="&lt;b&gt;值得评判时记录轮次&lt;/b&gt;&lt;br&gt;saos round --tier T[,T] --note [--merit]&lt;br&gt;小改动：saos check [--only id,…] 只测受影响项&lt;br&gt;距上次记轮次 ≥ 2 次优化或 ≥ 15 个脚本：结果带 since_round 提醒" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="490" y="2435.0" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="t9" value="&lt;b&gt;saos round&lt;/b&gt;：模型确认 → 同一套 checks → 判定只读&lt;br&gt;lenses/rounds/rNNN.optiland.json · ledger.jsonl · evaluations/NNN/&lt;br&gt;每轮记录 backend、stage、材料与交叠结果&lt;br&gt;阻断问题未答不记轮；viz.json 供工作流窗口显示" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Consolas;" parent="1" vertex="1">
          <mxGeometry x="980" y="2420.0" width="400" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a16" value="&lt;b&gt;按当前阶段判断终止&lt;/b&gt;&lt;br&gt;achieved / limit / exhausted / stopped&lt;br&gt;continue：返回诊断，选择下一种手段" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="500" y="2545.0" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="structure 无完整匹配确认 → 回到 ③ 重新描述并确认&lt;br&gt;进入 OpticStudio 后，重建与加载仍留在该后端" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#9673a6;fontColor=#4d3466;fontSize=11;align=left;spacingLeft=6;" parent="1" vertex="1">
