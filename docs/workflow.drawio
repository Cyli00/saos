        <mxCell id="zos_request" value="&lt;b&gt;记录认可，准备进入 OpticStudio&lt;/b&gt;&lt;br&gt;当前需求、模型与报告有效；所选轮次可交付&lt;br&gt;无 Optiland 模型玻璃近似；准备本阶段预算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="490" y="3180" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="zos_files" value="stages/zos.json：用户原话、来源轮次、报告与预算&lt;br&gt;ledger.jsonl：verify + verification_evidence&lt;br&gt;evaluations/NNN/result.json：backend = zos&lt;br&gt;stages/zos-result.json：需求项 / 基准 / 材料对比&lt;br&gt;untranslated：进入后须重设的优化设置" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;fontFamily=Consolas;" parent="1" vertex="1">
          <mxGeometry x="980" y="3400" width="400" height="130" as="geometry" />
        </mxCell>
        <mxCell id="zos_ready" value="&lt;b&gt;入口与对比均已封存？&lt;/b&gt;&lt;br&gt;只有文件存在还不算完成" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="510" y="3490" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="zos_pending" value="&lt;b&gt;入口未完成：处理错误后以原参数续跑&lt;/b&gt;&lt;br&gt;复用已提交的 verify 及同轮证据，不重复复测&lt;br&gt;完整封存前不开放后续轮次、优化、扫描与报告" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="490" y="3650" width="320" height="70" as="geometry" />
