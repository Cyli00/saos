        </mxCell>
        <mxCell id="e38" value="brief.review&lt;br&gt;（两轮无明显进步 / 将升 global、structure）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;dashed=1;strokeWidth=1.5;fontSize=11;fontColor=#b85450;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0;exitY=0.5;entryX=1;entryY=0.85;" parent="1" source="a16" target="u5" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="340" y="2450.0" />
              <mxPoint x="340" y="1925.0" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e39" value="改需求 → 新版本须重新确认&lt;br&gt;轮次重新计数" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;dashed=1;strokeWidth=1.5;fontSize=11;fontColor=#b85450;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0;exitY=0.5;entryX=0;entryY=0.7;" parent="1" source="u5" target="u2" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="68" y="1895.0" />
              <mxPoint x="68" y="710.0" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;dashed=1;strokeColor=#888888;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="a16" target="n1" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="u6" value="用户依据证据&lt;br&gt;决定停止" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="85" y="2580.0" width="240" height="56" as="geometry" />
        </mxCell>
        <mxCell id="t10" value="&lt;b&gt;saos stop --reason &quot;…&quot; --quote &quot;…&quot;&lt;/b&gt;&lt;br&gt;→ stops.jsonl；ledger 状态 stopped，此版本拒绝后续轮次" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Consolas;" parent="1" vertex="1">
          <mxGeometry x="980" y="2580.0" width="400" height="56" as="geometry" />
        </mxCell>
        <mxCell id="a17" value="&lt;b&gt;生成交付报告&lt;/b&gt;&lt;br&gt;需求或用户关心加工装配时先做公差扫描" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="490" y="2675.0" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="t11" value="&lt;b&gt;saos scan&lt;/b&gt;（tolerance 模式，按需）→ scans/NNN：灵敏度、蒙特卡洛、良率&lt;br&gt;&lt;b&gt;saos report&lt;/b&gt; → report/index.html（HTML，用户语言，含最近的公差扫描）&lt;br&gt;交付：G 最小的 achieved 轮，否则差距最小的可交付轮&lt;br&gt;全无有效轮次时写明“没有有效设计”&lt;br&gt;返回值 deliver 只放可交付镜头，否则为空、诊断轮在 diagnostic&lt;br&gt;停止时写明理由与用户原话" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Consolas;" parent="1" vertex="1">
          <mxGeometry x="980" y="2660.0" width="400" height="124" as="geometry" />
        </mxCell>
        <mxCell id="a18" value="把报告路径交给用户&lt;br&gt;没做公差时说明可接着做" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="490" y="2790.0" width="320" height="54" as="geometry" />
        </mxCell>
        <mxCell id="u7" value="阅读交付报告" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="85" y="2795.0" width="240" height="44" as="geometry" />
        </mxCell>
        <mxCell id="e41" value="决定停止" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=10;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" source="u5" target="u6" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e42" value="原话 + 选项全文" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=10;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" source="u6" target="t10" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e43" value="achieved / limit / exhausted" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=10;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" source="a16" target="a17" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e44" value="报告显示停止理由" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#82b366;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" source="t10" target="t11" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#82b366;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" source="a17" target="t11" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=10;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" source="a17" target="a18" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=10;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" source="a18" target="u7" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="&lt;b style=&quot;font-size:14px&quot;&gt;底线（不可违反）&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. &lt;b&gt;记录需求&lt;/b&gt;：用户原话 → interview.md；当前需求 → demand.yaml&lt;br&gt;2. &lt;b&gt;实测依据&lt;/b&gt;：交付的每个数值来自 OpticStudio 实算并归档；手算估计只用于推理&lt;br&gt;3. &lt;b&gt;不偷偷放宽&lt;/b&gt;：达不到就说差多少；改常量 / 范围 / 目标须用户重新确认&lt;br&gt;4. &lt;b&gt;交付用真实材料&lt;/b&gt;：模型玻璃只用于探索，含模型玻璃的轮次不可交付&lt;br&gt;5. &lt;b&gt;报告统一 HTML&lt;/b&gt;：面向用户的报告一律 .html" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;arcSize=4;fillColor=#fdf2f2;strokeColor=#b85450;" parent="1" vertex="1">
          <mxGeometry x="1450" y="40" width="400" height="250" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="&lt;b style=&quot;font-size:14px&quot;&gt;手段层级（低 → 高）与终止规则&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;local&lt;/b&gt;　现有变量下局部优化&lt;br&gt;&lt;b&gt;variables&lt;/b&gt;　放开更多变量 / 调整评价函数&lt;br&gt;&lt;b&gt;materials&lt;/b&gt;　换有来源的材料&lt;br&gt;&lt;b&gt;global&lt;/b&gt;　全局搜索或 Hammer&lt;br&gt;&lt;b&gt;structure&lt;/b&gt;　增减镜片、拆分、非球面化&lt;br&gt;&lt;br&gt;判断顺序：&lt;br&gt;① achieved：所有带界限项达标且无模型玻璃；有 minimize / maximize 目标时还要到理想值或各层级不再明显进步&lt;br&gt;② limit：达到轮次上限（默认 30，按需求版本计，rebase 不计）&lt;br&gt;③ exhausted：最后一次明显进步（≥ rel = 1%）后，允许的每个层级都试过或带证据排除（saos rule-out）仍无进步&lt;br&gt;④ stopped：用户 saos stop&lt;br&gt;⑤ 否则 continue，给出既没试过也没排除的最低层级 next_tier&lt;br&gt;一轮可声明多个层级；层级是记录，不是必走顺序&lt;br&gt;&lt;br&gt;比较轮次看目标差距（shortfall），不看 merit 值" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;arcSize=4;fillColor=#fffaf0;strokeColor=#d79b00;" parent="1" vertex="1">
          <mxGeometry x="1450" y="310" width="400" height="390" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="&lt;b style=&quot;font-size:14px&quot;&gt;何时停下来问用户&lt;/b&gt;&lt;br&gt;&lt;br&gt;• 需求自相矛盾，或常量 / 范围 / 达标线依据不足&lt;br&gt;• 测量口径有多种读法且影响结果&lt;br&gt;• 可行性判断或一阶分析表明结构达不到目标，或某项 must 差通过线好几倍&lt;br&gt;• 已有结果不支持继续当前策略（brief.review）&lt;br&gt;• 结构要改成用户没见过的样子&lt;br&gt;&lt;br&gt;会改变需求的问题写成 open_questions（blocking: true），未答时 round / opt local / hammer / global 拒绝运行&lt;br&gt;停下来之前先 saos ui notify，窗口顶部写明要用户看什么" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;arcSize=4;fillColor=#fffdf0;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="1450" y="720" width="400" height="250" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="&lt;b style=&quot;font-size:14px&quot;&gt;长任务与算力&lt;/b&gt;&lt;br&gt;&lt;br&gt;• 光学数值一律经 ZOS-API 计算，不自写追迹 / 近轴计算（ADR-0008）&lt;br&gt;• 先用现成工具，不现写封装：saos.kit（按注释读写参数、追迹、点列、操作数）、ctx.measure（按需求单实测）、saos.search（求根、寻优）&lt;br&gt;• 扫描 / 逐点求解 / 多起点用 saos scan；脚本里用 ctx.map，都跑在后台进程常驻的 worker 池（空闲 10 分钟关闭）；许可上限 8，含用户窗口&lt;br&gt;• 长操作默认暂停窗口刷新，结束后刷新一次（exec --live 全程刷新）&lt;br&gt;• 判定代码改了：下一次 round 先用新判定重测最好的一轮（rebase），数值不变则比较窗口延续&lt;br&gt;• 同一段代码第二个任务又抄时，上收为配方草稿（如 saos.recipes.fiber）&lt;br&gt;• opt local / hammer / global、round、check、scan、exec 写 progress.json；job show 看进度，job cancel 停止；写进度失败不中断计算&lt;br&gt;• 可能超过自己命令时限的 exec / opt / check / round 加 --detach，结果在 runs/；客户端超时不等于失败，别重复提交&lt;br&gt;• 沿视场 / 光谱取极值用 ctx.cra / field_profile / wave_profile，coverage 不够就是没测完&lt;br&gt;• opt local 设 --max-seconds，hammer / global 必须设（不会自己结束）；脚本里 ctx.progress 分段，一段收益 &amp;lt; rel 就停&lt;br&gt;• 精度服从可达性：差好几倍时不做收敛审计&lt;br&gt;• 给用户留 2 个逻辑核，自起长进程用低于正常优先级" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;arcSize=4;fillColor=#f3faf1;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="1450" y="990" width="400" height="450" as="geometry" />
        </mxCell>
        <mxCell id="p5" value="&lt;b style=&quot;font-size:14px&quot;&gt;封存与校验&lt;/b&gt;&lt;br&gt;&lt;br&gt;evaluations/、rounds/、models/、parallel/、scans/、report/NNN-* 等写入 seals.jsonl&lt;br&gt;saos job verify 报告事后改动；有改动时 saos report 拒绝运行" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;arcSize=4;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="1450" y="1460" width="400" height="140" as="geometry" />
        </mxCell>
        <mxCell id="lg" value="&lt;b style=&quot;font-size:14px&quot;&gt;图例&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;arcSize=4;fillColor=#ffffff;strokeColor=#999999;" parent="1" vertex="1">
          <mxGeometry x="1450" y="1770" width="400" height="330" as="geometry" />
