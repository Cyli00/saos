        </mxCell>
        <mxCell id="subtitle" value="同一个后台进程按阶段切换后端；切换时镜头经 .zmx 交给另一边并逐值比对。rtc 复现不了的镜头（坐标断点、非 Standard 反射镜等）整个流程留在 OpticStudio。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11.5;fontColor=#6B7280;" vertex="1" parent="1">
          <mxGeometry x="30" y="46" width="1000" height="22" as="geometry" />
        </mxCell>
