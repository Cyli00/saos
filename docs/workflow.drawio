          </mxGeometry>
        </mxCell>
        <mxCell id="zos_incomplete" parent="1" edge="1" source="zos_ready" target="zos_pending" value="否 / 入口报错" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=10;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="zos_retry" parent="1" edge="1" source="zos_pending" target="zos_request" value="修复条件后，同参数重试" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;dashed=1;strokeWidth=1.5;fontSize=11;fontColor=#b85450;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;">
          <mxGeometry relative="1" as="geometry">
