        <mxCell id="lget2" value="回退 / 求助用户" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="1522" y="2050" width="130" height="24" as="geometry" />
        </mxCell>
        <mxCell id="lge3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=2;fontSize=11;fontColor=#b46504;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;align=left;labelPosition=right;" parent="1" edge="1">
