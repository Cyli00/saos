        <mxCell id="title" value="&lt;b&gt;saos 工作流：前三个阶段在 rtc 上算，交付在 OpticStudio 上&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=16;fontColor=#111827;" vertex="1" parent="1">
