        <mxCell id="lget3" value="轮次循环" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="1712" y="2050" width="130" height="24" as="geometry" />
        </mxCell>
        <mxCell id="title" value="&lt;b style=&quot;font-size:20px&quot;&gt;saos workflow&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;依据 skills/saos/SKILL.md、DESIGN.md、src/saos/workflow.py、daemon.py（分支 saos，2026-10-17 更新）&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1450" y="-70" width="500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a0" value="&lt;b&gt;会话开始：环境预检&lt;/b&gt;&lt;br&gt;缺什么在第一条回复里就说" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="490" y="60" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="t0" value="&lt;b&gt;saos daemon status&lt;/b&gt;&lt;br&gt;environment：各实例后台进程 · 模式 · 在跑任务&lt;br&gt;OpticStudio 进程 / 许可余量（上限 8）· 可见窗口 · extension 能否启动" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Consolas;" vertex="1" parent="1">
          <mxGeometry x="980" y="52" width="400" height="66" as="geometry" />
        </mxCell>
        <mxCell id="e0a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#82b366;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a0" target="t0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e0b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=10;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a0" target="a1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a2b" value="&lt;b&gt;从物理上质疑结构（写需求单之前）&lt;/b&gt;&lt;br&gt;每个元件的作用；增删后其余部分还能否承担&lt;br&gt;优化器动不了的界限：光展量 / 拉氏不变量、Petzval、衍射极限、临界角、空间与口径、自由度 vs 目标数&lt;br&gt;制造工艺做不到什么（镀膜、面形、尺寸、材料）&lt;br&gt;公式手算界限（feasibility.md）+ 追迹/操作数核实决定性的数，不用优化器 → 每项 must：可达 / 边缘 / 不可达" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="490" y="320" width="320" height="170.0" as="geometry" />
        </mxCell>
        <mxCell id="e6b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=10;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a2b" target="a3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a13b" value="&lt;b&gt;差距闸门&lt;/b&gt;&lt;br&gt;预计 &amp;gt;10 min 或 global / structure 前&lt;br&gt;差几倍？已证明有上限？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="490" y="1990.0" width="320" height="150" as="geometry" />
        </mxCell>
        <mxCell id="e32b" value="差距在几成以内、无上限&lt;br&gt;先告诉用户：差多少 · 机理 · 变量 · 预期收益" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=10;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a13b" target="a14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e32c" value="差通过线好几倍&lt;br&gt;或诊断已证明有上限" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;dashed=1;strokeWidth=1.5;fontSize=11;fontColor=#b85450;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="a13b" target="u5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6" value="&lt;b style=&quot;font-size:14px&quot;&gt;上下文经济&lt;/b&gt;&lt;br&gt;&lt;br&gt;• 大文件按章节读，辅助库用到时再读&lt;br&gt;• 选型表交给 optic-material-explorer（haiku · effort high），只拿回带出处的表&lt;br&gt;• 待答问题可能推翻的工作，先等答复" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;arcSize=4;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1450" y="1620" width="400" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
